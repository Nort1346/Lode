# ── StreamHub ──────────────────────────────────────────────
NUXT_SESSION_PASSWORD=

# ── qBittorrent (required) ────────────────────────────────
NUXT_QBITTORRENT_URL=http://qbittorrent:8080
NUXT_QBITTORRENT_API_KEY=

# ── Jellyfin (optional) ───────────────────────────────────
NUXT_JELLYFIN_URL=http://jellyfin:8096
NUXT_JELLYFIN_API_KEY=

# ── Redis (optional, for caching) ─────────────────────────
NUXT_REDIS_URL=redis://redis:6379

# ── TMDB + Prowlarr (required) ────────────────────────────
NUXT_TMDB_API_KEY=
NUXT_PROWLARR_URL=http://prowlarr:9696
NUXT_PROWLARR_API_KEY=

# ── FlareSolverr (optional, for private trackers) ─────────
NUXT_FLARESOLVERR_URL=http://flaresolverr:8191

# ── Save paths (inside Docker, mounted from host) ─────────
NUXT_SAVE_PATH_MOVIES=/media/Movies
NUXT_SAVE_PATH_SERIES=/media/Series
NUXT_SAVE_PATH_GAMES=/media/Games
NUXT_SAVE_PATH_BOOKS=/media/Books
NUXT_SAVE_PATH_MUSIC=/media/Music

# ── Discord webhook (optional) ────────────────────────────
NUXT_DISCORD_WEBHOOK_URL=

# ── Disk space monitoring (optional) ──────────────────────
NUXT_DISKS=/media
NUXT_MIN_FREE_SPACE_GB=7
NUXT_DISK_SPACE_CHECK_ENABLED=true

# ── Encryption key for tracker passwords (required) ───────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_TRACKER_ENCRYPTION_KEY=replace_me_with_64_hex_chars

# ── Database (sqlite default, postgres optional) ──────────
DB_DRIVER=sqlite
# DATABASE_URL=postgresql://streamhub:${POSTGRES_PASSWORD}@postgres:5432/streamhub
# POSTGRES_PASSWORD=changeme

# ── VAPID keys for push notifications (optional) ─────────
# Generate with: node -e "const wp = require('web-push'); const k = wp.generateVAPIDKeys(); console.log(k.publicKey); console.log(k.privateKey)"
NUXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
NUXT_VAPID_PRIVATE_KEY=your-vapid-private-key
NUXT_VAPID_SUBJECT=mailto:admin@example.com
