NUXT_QUI_PROXY_URL=http://localhost:7476/proxy/YOUR_PROXY_KEY_HERE

NUXT_SESSION_PASSWORD=change_this_to_random_32_chars_min

NUXT_JELLYFIN_URL=http://localhost:8096
NUXT_JELLYFIN_API_KEY=your-jellyfin-api-key-here

NUXT_REDIS_URL=redis://localhost:6379

NUXT_TMDB_API_KEY=your-tmdb-api-key-here
NUXT_PROWLARR_URL=http://127.0.0.1:9696
NUXT_PROWLARR_API_KEY=your-prowlarr-api-key-here

NUXT_SAVE_PATH_MOVIES=/mnt/storage/streaming/Movies
NUXT_SAVE_PATH_SERIES=/mnt/storage/streaming/Series
NUXT_SAVE_PATH_GAMES=/mnt/storage/streaming/Games
NUXT_SAVE_PATH_BOOKS=/mnt/storage/streaming/Books
NUXT_SAVE_PATH_MUSIC=/mnt/storage/streaming/Music

# Discord webhook for download completion notifications
NUXT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# FlareSolverr for Cloudflare bypass on Polish trackers (optional)
NUXT_FLARESOLVERR_URL=http://127.0.0.1:8191

# Disk space monitoring (comma-separated mount paths)
NUXT_DISKS=/mnt/storage/streaming,/host-root
NUXT_MIN_FREE_SPACE_GB=7
NUXT_DISK_SPACE_CHECK_ENABLED=true

# Encryption key for tracker passwords in DB (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NUXT_TRACKER_ENCRYPTION_KEY=replace_me_with_64_hex_chars

# Database driver: 'sqlite' (default) or 'postgres'
DB_DRIVER=sqlite

# PostgreSQL connection URL (only needed when DB_DRIVER=postgres)
DATABASE_URL=postgresql://streamhub:changeme@localhost:5432/streamhub
