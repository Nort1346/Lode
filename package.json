{
  "name": "lode",
  "version": "1.0.1",
  "private": false,
  "description": "Self-hosted streaming hub for managing torrent downloads. Browse movies and TV shows via TMDB, rank torrents, and download with one click.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nort1346/Lode.git"
  },
  "homepage": "https://github.com/Nort1346/Lode#readme",
  "bugs": {
    "url": "https://github.com/Nort1346/Lode/issues"
  },
  "keywords": [
    "streaming",
    "self-hosted",
    "jellyfin",
    "torrent",
    "prowlarr",
    "qbittorrent",
    "media-server",
    "tmdb",
    "nuxt",
    "docker",
    "private-trackers",
    "open-source"
  ],
  "type": "module",
  "author": {
    "name": "Nort1346",
    "email": "contact@nort.space",
    "url": "https://nort.space"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nuxt build",
    "dev": "node scripts/migrate.mjs && nuxt dev",
    "build:preview": "pnpm run build && pnpm run preview --host",
    "preview": "node scripts/migrate.mjs && nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "node scripts/prepare.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p test/tsconfig.json",
    "typecheck:test": "vue-tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@discordjs/builders": "^1.14.1",
    "@discordjs/formatters": "^0.6.2",
    "@discordjs/rest": "^2.6.3",
    "@iconify-json/lucide": "^1.2.131",
    "@iconify-json/simple-icons": "^1.2.95",
    "@node-rs/bcrypt": "^1.10.9",
    "@nuxt/hints": "1.1.4",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "^4.11.1",
    "@nuxtjs/i18n": "^10.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "got-scraping": "^4.2.1",
    "ioredis": "^6.0.0",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "discord-api-types": "^0.38.55",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.3",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
