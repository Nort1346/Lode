{
  "name": "streamhub",
  "version": "1.0.0",
  "private": false,
  "description": "Self-hosted streaming hub for managing torrent downloads. Browse movies and TV shows via TMDB, rank torrents, and download with one click.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nort1346/StreamHub.git"
  },
  "homepage": "https://github.com/Nort1346/StreamHub#readme",
  "bugs": {
    "url": "https://github.com/Nort1346/StreamHub/issues"
  },
  "keywords": [
    "streaming",
    "self-hosted",
    "jellyfin",
    "torrent",
    "prowlarr",
    "qbittorrent",
    "media-server",
    "tmdb",
    "nuxt",
    "docker",
    "private-trackers",
    "open-source"
  ],
  "type": "module",
  "author": {
    "name": "Nort1346",
    "email": "contact@nort.space",
    "url": "https://nort.space"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "nuxt build",
    "dev": "node scripts/migrate.mjs && nuxt dev",
    "build:preview": "pnpm run build && pnpm run preview --host",
    "preview": "node scripts/migrate.mjs && nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p test/tsconfig.json",
    "typecheck:test": "vue-tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@dicebear/core": "^10.3.0",
    "@dicebear/styles": "^10.2.0",
    "@discordjs/builders": "^1.14.1",
    "@discordjs/formatters": "^0.6.2",
    "@discordjs/rest": "^2.6.3",
    "@iconify-json/lucide": "^1.2.119",
    "@iconify-json/simple-icons": "^1.2.91",
    "@node-rs/bcrypt": "^1.10.7",
    "@nuxt/hints": "1.1.4",
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.5.0",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "got-scraping": "^4.2.1",
    "ioredis": "^5.11.1",
    "nuxt": "^4.5.0",
    "nuxt-auth-utils": "^0.5.29",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "discord-api-types": "^0.38.51",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
